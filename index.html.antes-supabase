];

let comandas = carregar();
let filtroAtual = 'all';
let comandaAtualId = null;
let categoriaAtual = 'Todas';
let buscaProduto = '';

function carregar(){
  try{
    const dados = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    return Array.isArray(dados) ? dados : [];
  }catch(e){return []}
}

function salvar(){
  localStorage.setItem(STORAGE_KEY,JSON.stringify(comandas));
}

function moeda(valor){
  return Number(valor || 0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
}

function dataLocal(date = new Date()){
  const ano = date.getFullYear();
  const mes = String(date.getMonth()+1).padStart(2,'0');
  const dia = String(date.getDate()).padStart(2,'0');
  return `${ano}-${mes}-${dia}`;
}

function totalComanda(c){
  return (c.itens || []).reduce((s,item)=>s + item.preco*item.qtd,0);
}

function dataBonita(data){
  if(!data)return '';
  const [a,m,d] = data.split('-');
  return `${d}/${m}/${a}`;
}

function toast(msg){
  const el=document.getElementById('toast');
  el.textContent=msg;
  el.classList.add('show');
  clearTimeout(toast.timer);
  toast.timer=setTimeout(()=>el.classList.remove('show'),2400);
}

function navegar(pagina){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById('page-'+pagina).classList.add('active');
  document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===pagina));
  if(pagina==='inicio')renderComandas();
  if(pagina==='financeiro')renderFinanceiro();
}

document.querySelectorAll('.nav button').forEach(btn=>{
  btn.addEventListener('click',()=>navegar(btn.dataset.page));
});

document.querySelectorAll('.filter button').forEach(btn=>{
  btn.addEventListener('click',()=>{
    filtroAtual=btn.dataset.filter;
    document.querySelectorAll('.filter button').forEach(b=>b.classList.toggle('active',b===btn));
    renderComandas();
  });
});

function novaComanda(){
  document.getElementById('command-type').value='Mesa';
  document.getElementById('command-number').value='';
  document.getElementById('command-person').value='';
  navegar('criar');
  setTimeout(()=>document.getElementById('command-number').focus(),100);
}

function criarComanda(){
  const tipo=document.getElementById('command-type').value;
  const identificacao=document.getElementById('command-number').value.trim();
  const cliente=document.getElementById('command-person').value.trim();

  if(!identificacao){
    toast('Informe o número ou identificação.');
    document.getElementById('command-number').focus();
    return;
  }

  const repetida=comandas.some(c=>
    c.status==='open' &&
    c.tipo===tipo &&
    c.identificacao.toLowerCase()===identificacao.toLowerCase()
  );

  if(repetida){
    toast('Já existe uma comanda aberta para essa identificação.');
    return;
  }

  const comanda={
    id:crypto.randomUUID ? crypto.randomUUID() : String(Date.now()+Math.random()),
    tipo,
    identificacao,
    cliente,
    status:'open',
    criadaEm:new Date().toISOString(),
    dataAbertura:dataLocal(),
    itens:[],
    totalFechado:null,
    fechadaEm:null,
    dataPagamento:null,
    formaPagamento:null
  };

  comandas.unshift(comanda);
  salvar();
  toast('Comanda criada! Adicione os produtos.');
  abrirDetalhes(comanda.id);
}

function renderComandas(){
  const abertas=comandas.filter(c=>c.status==='open');
  const fechadas=comandas.filter(c=>c.status==='closed');
  const hoje=dataLocal();

  document.getElementById('stat-open').textContent=abertas.length;
  document.getElementById('stat-closed').textContent=fechadas.length;
  document.getElementById('stat-today').textContent=moeda(
    fechadas.filter(c=>c.dataPagamento===hoje).reduce((s,c)=>s+Number(c.totalFechado||0),0)
  );
  document.getElementById('stat-pending').textContent=moeda(
    abertas.reduce((s,c)=>s+totalComanda(c),0)
  );

  const busca=(document.getElementById('search-orders').value||'').toLowerCase();
  const lista=comandas.filter(c=>{
    const statusOk=filtroAtual==='all' || c.status===filtroAtual;
    const texto=`${c.tipo} ${c.identificacao} ${c.cliente||''}`.toLowerCase();
    return statusOk && texto.includes(busca);
  });

  const grid=document.getElementById('orders-grid');
  if(!lista.length){
    grid.innerHTML=`<div class="empty"><div class="empty-icon">▤</div><strong>Nenhuma comanda encontrada</strong><span>Crie uma comanda para começar um atendimento.</span></div>`;
    return;
  }

  grid.innerHTML=lista.map(c=>{
    const total=c.status==='closed'?Number(c.totalFechado||0):totalComanda(c);
    const qtd=(c.itens||[]).reduce((s,i)=>s+i.qtd,0);
    return `
      <article class="order-card" onclick="abrirDetalhes('${c.id}')">
        <div class="order-top">
          <div>
            <div class="order-name">${escapar(c.tipo)} ${escapar(c.identificacao)}</div>
            <div class="order-type">${c.cliente?escapar(c.cliente)+' · ':''}${c.status==='open'?'Aberta em '+dataBonita(c.dataAbertura):'Fechada em '+dataBonita(c.dataPagamento)}</div>
          </div>
          <span class="pill ${c.status==='open'?'open':'closed'}">${c.status==='open'?'Aberta':'Fechada'}</span>
        </div>
        <div class="order-info">
          <div><span>${qtd} ${qtd===1?'item':'itens'}</span><div style="margin-top:5px;font-size:11px;color:var(--muted)">${c.status==='closed'?'Pagamento: '+escapar(c.formaPagamento||'Não informado'):'Toque para abrir'}</div></div>
          <div class="order-total">${moeda(total)}</div>
        </div>
      </article>`;
  }).join('');
}

function escapar(texto){
  return String(texto??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function abrirDetalhes(id){
  const c=comandas.find(x=>x.id===id);
  if(!c)return;
  comandaAtualId=id;
  document.getElementById('modal-title').textContent=`${c.tipo} ${c.identificacao}`;
  renderDetalhes();
  document.getElementById('detail-modal').classList.add('show');
}

function fecharModal(){
  document.getElementById('detail-modal').classList.remove('show');
  comandaAtualId=null;
  renderComandas();
}

function fecharModalFora(event){
  if(event.target.id==='detail-modal')fecharModal();
}

function statusCozinha(status){
  const nomes = {
    waiting: 'Em espera',
    preparing: 'Em preparo',
    ready: 'Pronto para retirada',
    delivered: 'Entregue ao garçom'
  };
  return nomes[status || 'waiting'] || 'Em espera';
}

function renderDetalhes(){
  const c=comandas.find(x=>x.id===comandaAtualId);
  if(!c)return;

  const total=c.status==='closed'?Number(c.totalFechado||0):totalComanda(c);
  let html='';

  if(c.status==='open'){
    html+=`
      <div class="panel" style="padding:15px;margin-bottom:16px">
        <div class="eyebrow">Adicionar produtos</div>
        <div class="field" style="margin-top:12px">
          <label>Pesquisar produto</label>
          <input id="product-search" placeholder="Digite o nome do produto..." oninput="buscaProduto=this.value;renderProdutos()" value="${escapar(buscaProduto)}">
        </div>
        <div class="product-categories" id="product-categories" style="margin-top:13px"></div>
        <div class="products-grid" id="products-grid"></div>
      </div>`;
  }

  html+=`<div class="detail-layout">
    <div class="panel">
      <div class="eyebrow">Produtos da comanda</div>
      <div style="margin-top:10px">`;

  if(!c.itens.length){
    html+=`<div class="empty" style="padding:30px 12px"><strong>Comanda sem produtos</strong><span>Adicione os produtos acima.</span></div>`;
  }else{
    html+=c.itens.map((item,index)=>`
      <div class="item-row">
        <div>
          <strong>${escapar(item.nome)}</strong>
          <small>${moeda(item.preco)} cada · ${moeda(item.preco*item.qtd)}</small>
          <small style="display:block;margin-top:6px;color:var(--gold);font-weight:700">Cozinha: ${statusCozinha(item.kitchenStatus)}</small>
        </div>
        ${c.status==='open'?`
          <div class="qty">
            <button onclick="alterarQtd(${index},-1)">−</button>
            <span>${item.qtd}</span>
            <button onclick="alterarQtd(${index},1)">+</button>
            <button onclick="removerItem(${index})" title="Remover" style="color:var(--red)">×</button>
          </div>`:`<strong>× ${item.qtd}</strong>`}
      </div>`).join('');
  }
  html+=`</div></div>
    <aside class="panel">
      <div class="eyebrow">Resumo</div>
      <div class="detail-total">${moeda(total)}</div>
      <div class="summary-line"><span>Quantidade de itens</span><strong>${c.itens.reduce((s,i)=>s+i.qtd,0)}</strong></div>
      <div class="summary-line"><span>Situação</span><strong>${c.status==='open'?'Em aberto':'Fechada'}</strong></div>
      ${c.status==='closed'?`
        <div class="summary-line"><span>Pagamento</span><strong>${escapar(c.formaPagamento||'')}</strong></div>
        <div class="summary-line"><span>Data do pagamento</span><strong>${dataBonita(c.dataPagamento)}</strong></div>
      `:''}
      ${c.status==='open'?`
        <button class="btn btn-primary" style="width:100%;margin-top:13px" onclick="abrirFechamento()">Fechar comanda</button>
        <button class="btn btn-danger" style="width:100%;margin-top:9px" onclick="excluirComanda()">Excluir comanda</button>
      `:`
        <button class="btn btn-secondary" style="width:100%;margin-top:13px" onclick="reabrirComanda()">Reabrir comanda</button>
      `}
    </aside>
  </div>`;

  document.getElementById('modal-content').innerHTML=html;
  if(c.status==='open')renderProdutos();
}

function renderProdutos(){
  const grid=document.getElementById('products-grid');
  const cats=document.getElementById('product-categories');
  if(!grid||!cats)return;

  const categorias=['Todas',...new Set(produtos.map(p=>p.categoria))];
  cats.innerHTML=categorias.map(cat=>`
    <button class="category-btn ${categoriaAtual===cat?'active':''}" onclick="categoriaAtual='${escapar(cat)}';renderProdutos()">${escapar(cat)}</button>
  `).join('');

  const lista=produtos.filter(p=>
    (categoriaAtual==='Todas'||p.categoria===categoriaAtual) &&
    p.nome.toLowerCase().includes(buscaProduto.toLowerCase())
  );

  grid.innerHTML=lista.map(p=>{
    const idx=produtos.indexOf(p);
    return `<div class="product">
      <div class="product-name">${escapar(p.nome)}</div>
      <div class="product-bottom">
        <span class="product-price">${moeda(p.preco)}</span>
        <button class="add-product" onclick="adicionarProduto(${idx})">+</button>
      </div>
    </div>`;
  }).join('')||'<div class="empty" style="grid-column:1/-1">Nenhum produto encontrado.</div>';

  const input=document.getElementById('product-search');
  if(input&&input.value!==buscaProduto)input.value=buscaProduto;
}

function adicionarProduto(index){
  const c=comandas.find(x=>x.id===comandaAtualId);
  const p=produtos[index];
  if(!c||!p||c.status!=='open')return;

  const existente=c.itens.find(i=>i.nome===p.nome);
  if(existente){existente.qtd++;existente.kitchenStatus='waiting';}
  else c.itens.push({nome:p.nome,preco:p.preco,qtd:1,kitchenStatus:'waiting'});

  salvar();
  renderDetalhes();
  renderComandas();
  toast(`${p.nome} adicionado.`);
}

function alterarQtd(index,delta){
  const c=comandas.find(x=>x.id===comandaAtualId);
  if(!c||c.status!=='open')return;
  const item=c.itens[index];
  if(!item)return;
  item.qtd+=delta;
  if(item.qtd<=0)c.itens.splice(index,1);
  salvar();
  renderDetalhes();
  renderComandas();
}

function removerItem(index){
  const c=comandas.find(x=>x.id===comandaAtualId);
  if(!c||c.status!=='open')return;
  c.itens.splice(index,1);
  salvar();
  renderDetalhes();
  renderComandas();
  toast('Produto removido.');
}

function abrirFechamento(){
  const c=comandas.find(x=>x.id===comandaAtualId);
  if(!c||!c.itens.length){
    toast('Adicione pelo menos um produto antes de fechar.');
    return;
  }
  const total=totalComanda(c);
  document.getElementById('modal-title').textContent='Fechar comanda';
  document.getElementById('modal-content').innerHTML=`
    <div class="panel">
      <div class="eyebrow">Confirmar recebimento</div>
      <div class="detail-total">${moeda(total)}</div>
      <div class="field">
        <label>Forma de pagamento</label>
        <select id="payment-method">
          <option value="Dinheiro">Dinheiro</option>
          <option value="Pix">Pix</option>
          <option value="Cartão de débito">Cartão de débito</option>
          <option value="Cartão de crédito">Cartão de crédito</option>
        </select>
      </div>
      <p class="subtitle" style="line-height:1.7;margin-top:14px">Ao confirmar, a comanda será marcada como fechada e o valor será contabilizado no financeiro na data de hoje.</p>
      <div class="modal-actions">
        <button class="btn btn-primary" onclick="confirmarFechamento()">Confirmar recebimento</button>
        <button class="btn btn-secondary" onclick="abrirDetalhes('${c.id}')">Voltar</button>
      </div>
    </div>`;
}

function confirmarFechamento(){
  const c=comandas.find(x=>x.id===comandaAtualId);
  if(!c||c.status!=='open')return;
  const metodo=document.getElementById('payment-method').value;
  c.totalFechado=totalComanda(c);
  c.status='closed';
  c.formaPagamento=metodo;
  c.fechadaEm=new Date().toISOString();
  c.dataPagamento=dataLocal();
  salvar();
  toast('Comanda fechada e pagamento registrado!');
  abrirDetalhes(c.id);
  renderComandas();
}

function reabrirComanda(){
  const c=comandas.find(x=>x.id===comandaAtualId);
  if(!c||c.status!=='closed')return;
  if(!confirm('Reabrir esta comanda? O recebimento deixará de contar no financeiro.'))return;
  c.status='open';
  c.totalFechado=null;
  c.formaPagamento=null;
  c.fechadaEm=null;
  c.dataPagamento=null;
  salvar();
  toast('Comanda reaberta.');
  abrirDetalhes(c.id);
  renderComandas();
}

function excluirComanda(){
  const c=comandas.find(x=>x.id===comandaAtualId);
  if(!c)return;
  if(!confirm('Tem certeza que deseja excluir esta comanda?'))return;
  comandas=comandas.filter(x=>x.id!==c.id);
  salvar();
  fecharModal();
  toast('Comanda excluída.');
}

function somaRecebimentos(lista){
  return lista.filter(c=>c.status==='closed').reduce((s,c)=>s+Number(c.totalFechado||0),0);
}

function renderFinanceiro(){
  const hoje=dataLocal();
  const ontemDate=new Date();
  ontemDate.setDate(ontemDate.getDate()-1);
  const ontem=dataLocal(ontemDate);

  const mesAtual=hoje.slice(0,7);
  const dataEscolhida=document.getElementById('report-date').value||hoje;
  const mesEscolhido=document.getElementById('report-month').value||mesAtual;

  const recebidas=comandas.filter(c=>c.status==='closed'&&c.dataPagamento);
  const doDia=recebidas.filter(c=>c.dataPagamento===dataEscolhida);
  const doMes=recebidas.filter(c=>c.dataPagamento.startsWith(mesEscolhido));

  document.getElementById('report-yesterday').textContent=moeda(somaRecebimentos(recebidas.filter(c=>c.dataPagamento===ontem)));
  document.getElementById('report-today').textContent=moeda(somaRecebimentos(recebidas.filter(c=>c.dataPagamento===hoje)));
  document.getElementById('report-month').textContent=moeda(somaRecebimentos(recebidas.filter(c=>c.dataPagamento.startsWith(mesAtual))));

  document.getElementById('report-day-title').textContent='Recebimentos de '+dataBonita(dataEscolhida);
  document.getElementById('report-month-title').textContent='Fechamentos de '+mesEscolhido.split('-').reverse().join('/');

  const listaDia=document.getElementById('report-day-list');
  listaDia.innerHTML=doDia.length?doDia.map(c=>`
    <div class="history-row">
      <div><strong>${escapar(c.tipo)} ${escapar(c.identificacao)}</strong><small>${escapar(c.formaPagamento||'')} · ${c.itens.reduce((s,i)=>s+i.qtd,0)} itens</small></div>
      <b>${moeda(c.totalFechado)}</b>
    </div>`).join(''):'<div class="empty">Nenhum recebimento nesta data.</div>';

  const listaMes=document.getElementById('report-month-list');
  listaMes.innerHTML=doMes.length?doMes.map(c=>`
    <div class="history-row">
      <div><strong>${escapar(c.tipo)} ${escapar(c.identificacao)}</strong><small>${dataBonita(c.dataPagamento)} · ${escapar(c.formaPagamento||'')}</small></div>
      <b>${moeda(c.totalFechado)}</b>
    </div>`).join(''):'<div class="empty">Nenhum fechamento neste mês.</div>';
}

document.getElementById('report-date').value=dataLocal();
document.getElementById('report-month').value=dataLocal().slice(0,7);

renderComandas();
renderFinanceiro();
</script>

