<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#100d0b">
<title>Cutia Paradise | Cozinha</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root{
  --bg:#100d0b;
  --panel:#1a1511;
  --panel2:#211a14;
  --panel3:#2b2118;
  --gold:#f4b544;
  --orange:#f17c32;
  --cream:#fff4dc;
  --muted:#b7a997;
  --green:#67c58a;
  --red:#f07868;
  --blue:#79a9e8;
  --line:rgba(255,244,220,.09);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{
  margin:0;min-height:100vh;color:var(--cream);
  background:
    radial-gradient(ellipse at 85% 0%,rgba(241,124,50,.09),transparent 35%),
    radial-gradient(ellipse at 0% 65%,rgba(244,181,68,.04),transparent 35%),
    var(--bg);
  font-family:'DM Sans',sans-serif;
}
button{font:inherit;cursor:pointer}
button:focus{outline:none}
button:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.app{max-width:1550px;margin:auto;padding:24px}
.header{
  display:flex;justify-content:space-between;align-items:center;
  gap:15px;padding-bottom:22px;margin-bottom:28px;
  border-bottom:1px solid var(--line)
}
.brand{display:flex;align-items:center;gap:13px}
.logo{
  width:49px;height:49px;border-radius:15px;
  display:grid;place-items:center;
  background:linear-gradient(135deg,var(--gold),var(--orange));
  color:#25160a;font-size:24px;font-weight:900;
  box-shadow:0 8px 25px rgba(241,124,50,.2)
}
.brand h1{
  font-family:'Barlow Condensed',sans-serif;
  text-transform:uppercase;font-size:29px;line-height:1;margin:0
}
.brand p{
  font-size:10px;letter-spacing:2px;color:var(--muted);
  margin:5px 0 0;text-transform:uppercase
}
.header-right{
  display:flex;align-items:center;gap:8px;
  color:var(--green);font-size:11px;font-weight:700
}
.dot{
  width:8px;height:8px;border-radius:50%;
  background:var(--green);box-shadow:0 0 12px var(--green)
}
.heading{margin-bottom:23px}
.eyebrow{
  font-size:10px;color:var(--gold);
  font-weight:800;letter-spacing:2.5px;text-transform:uppercase
}
h2{
  font-family:'Barlow Condensed',sans-serif;
  font-size:40px;text-transform:uppercase;margin:6px 0
}
.subtitle{font-size:13px;color:var(--muted);margin:0;line-height:1.6}
.stats{
  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));
  gap:13px;margin-bottom:23px
}
.stat{
  background:linear-gradient(145deg,var(--panel2),var(--panel));
  border:1px solid var(--line);border-radius:16px;padding:18px;
  min-width:0
}
.stat-label{font-size:11px;color:var(--muted);font-weight:700}
.stat-value{font-size:27px;font-weight:800;margin-top:9px}
.stat.gold .stat-value{color:var(--gold)}
.stat.orange .stat-value{color:var(--orange)}
.stat.green .stat-value{color:var(--green)}
.stat.blue .stat-value{color:var(--blue)}
.stat-foot{font-size:10px;color:var(--muted);margin-top:4px}
.section-heading{
  display:flex;align-items:center;justify-content:space-between;
  gap:12px;margin:28px 0 14px
}
.section-heading h3{
  font-family:'Barlow Condensed',sans-serif;
  font-size:25px;text-transform:uppercase;margin:0
}
.section-heading span{font-size:11px;color:var(--muted)}
.category-shortcuts{
  display:flex;gap:8px;flex-wrap:wrap;margin-bottom:23px
}
.category-shortcuts button{
  display:flex;align-items:center;gap:8px;
  border:1px solid var(--line);background:var(--panel);
  color:var(--cream);padding:10px 13px;border-radius:11px;
  font-size:11px;font-weight:800
}
.category-shortcuts button:active{border-color:var(--gold)}
.category-shortcuts b{
  min-width:21px;height:21px;display:grid;place-items:center;
  border-radius:7px;background:rgba(244,181,68,.13);
  color:var(--gold);font-size:10px
}
.filters{
  display:flex;gap:8px;flex-wrap:wrap;margin:20px 0 26px
}
.filters button{
  border:1px solid var(--line);background:var(--panel);
  color:var(--muted);padding:11px 16px;border-radius:11px;
  font-size:11px;font-weight:800;transition:.2s
}
.filters button.active{
  color:var(--gold);border-color:rgba(244,181,68,.5);
  background:rgba(244,181,68,.1)
}
.category{margin:28px 0}
.category-title{
  display:flex;align-items:center;gap:12px;margin-bottom:14px
}
.category-title h3{
  font-family:'Barlow Condensed',sans-serif;
  font-size:27px;text-transform:uppercase;color:var(--gold);margin:0
}
.category-title .line{height:1px;background:var(--line);flex:1}
.category-count{
  color:var(--muted);font-size:10px;font-weight:700;
  white-space:nowrap
}
.cards{
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
  gap:13px
}
.order{
  background:linear-gradient(145deg,#211a14,#18130f);
  border:1px solid var(--line);border-radius:16px;
  padding:17px;min-width:0;transition:border-color .2s
}
.order.waiting{border-left:3px solid var(--gold)}
.order.preparing{border-left:3px solid var(--orange)}
.order.ready{border-left:3px solid var(--green)}
.order.delivered{border-left:3px solid var(--blue);opacity:.82}
.order-head{
  display:flex;justify-content:space-between;
  align-items:flex-start;gap:10px
}
.location{font-size:16px;font-weight:800}
.client{font-size:10px;color:var(--muted);margin-top:5px}
.status{
  font-size:9px;font-weight:800;text-transform:uppercase;
  letter-spacing:.5px;border-radius:20px;padding:7px 9px;
  white-space:nowrap;height:max-content
}
.status.waiting{background:rgba(244,181,68,.12);color:var(--gold)}
.status.preparing{background:rgba(241,124,50,.13);color:var(--orange)}
.status.ready{background:rgba(103,197,138,.13);color:var(--green)}
.status.delivered{background:rgba(121,169,232,.13);color:var(--blue)}
.product-name{
  font-size:19px;font-weight:800;margin:20px 0 5px;
  line-height:1.3
}
.quantity{font-size:12px;color:var(--muted)}
.order-footer{
  border-top:1px solid var(--line);
  margin-top:16px;padding-top:13px;
  display:flex;justify-content:space-between;
  gap:8px;align-items:center
}
.order-number{font-size:10px;color:var(--muted)}
.actions{display:flex;gap:8px;margin-top:15px;flex-wrap:wrap}
.actions button{
  flex:1;min-width:110px;border:0;border-radius:10px;
  padding:11px 9px;font-size:10px;font-weight:800;
  transition:filter .2s
}
.actions button:active{filter:brightness(.85)}
.primary{
  background:linear-gradient(135deg,var(--gold),var(--orange));
  color:#271708
}
.success{background:rgba(103,197,138,.15);color:var(--green);border:1px solid rgba(103,197,138,.25)!important}
.info{background:rgba(121,169,232,.13);color:var(--blue);border:1px solid rgba(121,169,232,.25)!important}
.secondary{
  background:var(--panel2);color:var(--cream);
  border:1px solid var(--line)!important
}
.empty{
  text-align:center;padding:55px 20px;
  border:1px dashed var(--line);border-radius:17px;
  color:var(--muted)
}
.empty-icon{font-size:35px;margin-bottom:12px}
.empty strong{display:block;color:var(--cream);margin:10px 0 5px}
.empty p{font-size:12px;line-height:1.6}
.footer{text-align:center;color:#766b5e;font-size:10px;margin:38px 0 10px}
.toast{
  position:fixed;bottom:20px;left:50%;
  transform:translate(-50%,20px);opacity:0;
  pointer-events:none;background:var(--panel2);
  border:1px solid rgba(244,181,68,.4);
  color:var(--cream);padding:12px 18px;
  border-radius:12px;font-size:12px;
  box-shadow:0 15px 40px #0008;transition:.2s;
  z-index:10;max-width:90%;text-align:center
}
.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:1050px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:650px){
  .app{padding:16px}
  .header{margin-bottom:22px}
  .stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
  .stat{padding:14px}
  .stat-value{font-size:23px}
  .cards{grid-template-columns:1fr}
  .filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
  .filters button{padding:11px 5px}
  h2{font-size:35px}
  .brand h1{font-size:25px}
  .header-right{font-size:0}
  .category-shortcuts{gap:7px}
  .category-shortcuts button{flex:1 1 auto;justify-content:space-between}
  .order{padding:16px}
  .actions button{min-height:42px}
}
</style>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="config.js"></script>
<script src="auth.js"></script>
<script src="cutia-db.js"></script>

</head>

<body>
<div class="app">

  <header class="header">
    <div class="brand">
      <div class="logo">C</div>
      <div>
        <h1>Cutia Paradise</h1>
        <p>Painel exclusivo da cozinha</p>
      </div>
    </div>
    <div class="header-right"><span class="dot"></span> Painel ativo</div>
  </header>

  <section class="heading">
    <div class="eyebrow">Central de produção</div>
    <h2>Pedidos recebidos</h2>
    <p class="subtitle">Os pedidos aparecem automaticamente separados por categoria.</p>
  </section>

  <section class="stats">
    <div class="stat gold">
      <div class="stat-label">Em espera</div>
      <div class="stat-value" id="waiting-count">0</div>
      <div class="stat-foot">Aguardando início</div>
    </div>
    <div class="stat orange">
      <div class="stat-label">Em preparo</div>
      <div class="stat-value" id="preparing-count">0</div>
      <div class="stat-foot">Na produção</div>
    </div>
    <div class="stat green">
      <div class="stat-label">Prontos</div>
      <div class="stat-value" id="ready-count">0</div>
      <div class="stat-foot">Aguardando retirada</div>
    </div>
    <div class="stat blue">
      <div class="stat-label">Entregues</div>
      <div class="stat-value" id="delivered-count">0</div>
      <div class="stat-foot">Entregues ao garçom</div>
    </div>
  </section>

  <div class="section-heading">
    <h3>Categorias recebidas</h3>
    <span id="category-total">0 categorias</span>
  </div>

  <nav class="category-shortcuts" id="category-shortcuts"></nav>

  <div class="section-heading">
    <h3>Acompanhamento dos pedidos</h3>
    <span id="last-update">Atualizando automaticamente</span>
  </div>

  <nav class="filters">
    <button class="active" data-filter="all">Todos</button>
    <button data-filter="waiting">Em espera</button>
    <button data-filter="preparing">Em preparo</button>
    <button data-filter="ready">Prontos</button>
    <button data-filter="delivered">Entregues</button>
  </nav>

  <main id="kitchen-content">
    <div class="empty">Carregando pedidos...</div>
  </main>

  <footer class="footer">CUTIA PARADISE · COZINHA</footer>
</div>

<div class="toast" id="toast"></div>

<script>
const STORAGE_KEY='cutia_comandas_v2';

const categorias=[
  'Drinks',
  'Cervejas',
  'Refrigerantes',
  'Doses',
  'Sucos naturais',
  'Petiscos',
  'Refeições',
  'Caldos',
  'Entradas e porções'
];

let filtro='all';
let ultimaVersao='';

function lerComandas(){
  try{
    const data=JSON.parse(localStorage.getItem(STORAGE_KEY)||'[]');
    return Array.isArray(data)?data:[];
  }catch(e){return []}
}

function salvarComandas(comandas){
  localStorage.setItem(STORAGE_KEY,JSON.stringify(comandas));
}

function escapar(v){
  return String(v??'').replace(/[&<>"']/g,c=>({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  })[c]);
}

function categoriaProduto(item){
  if(item.categoria && categorias.includes(item.categoria)){
    return item.categoria;
  }

  const nome=String(item.nome||'').toLowerCase();

  if(/caipirinha|caipifruta/.test(nome))return 'Drinks';
  if(/heineken|budweiser|itaipava|devassa|pitú|caranguejo|malzbier/.test(nome))return 'Cervejas';
  if(/coca|guaraná|pepsi/.test(nome))return 'Refrigerantes';
  if(/cachaça|conhaque/.test(nome))return 'Doses';
  if(/suco/.test(nome))return 'Sucos naturais';
  if(/camarão|filé|frango|calabresa|peixe/.test(nome))return 'Petiscos';
  if(/galinha|prato executivo|prato feito/.test(nome))return 'Refeições';
  if(/caldo/.test(nome))return 'Caldos';

  return 'Entradas e porções';
}

function nomeStatus(status){
  return {
    waiting:'Em espera',
    preparing:'Em preparo',
    ready:'Pronto para retirada',
    delivered:'Entregue ao garçom'
  }[status]||'Em espera';
}

function avisar(msg){
  const el=document.getElementById('toast');
  el.textContent=msg;
  el.classList.add('show');
  clearTimeout(avisar.timer);
  avisar.timer=setTimeout(()=>el.classList.remove('show'),2300);
}

function coletarItens(comandas){
  const itens=[];

  comandas.forEach(c=>{
    if(c.status!=='open')return;

    (c.itens||[]).forEach((item,index)=>{
      itens.push({
        comanda:c,
        item,
        index,
        categoria:categoriaProduto(item),
        status:item.kitchenStatus||'waiting'
      });
    });
  });

  return itens;
}

function render(){
  const comandas=lerComandas();
  const itens=coletarItens(comandas);

  const quantidade=status=>itens
    .filter(x=>x.status===status)
    .reduce((s,x)=>s+Number(x.item.qtd||0),0);

  document.getElementById('waiting-count').textContent=quantidade('waiting');
  document.getElementById('preparing-count').textContent=quantidade('preparing');
  document.getElementById('ready-count').textContent=quantidade('ready');
  document.getElementById('delivered-count').textContent=quantidade('delivered');

  const categoriasRecebidas=categorias.filter(cat=>
    itens.some(x=>x.categoria===cat)
  );

  const shortcuts=document.getElementById('category-shortcuts');
  document.getElementById('category-total').textContent=
    `${categoriasRecebidas.length} ${categoriasRecebidas.length===1?'categoria':'categorias'}`;

  shortcuts.innerHTML=categoriasRecebidas.length
    ?categoriasRecebidas.map(cat=>{
      const total=itens.filter(x=>x.categoria===cat)
        .reduce((s,x)=>s+Number(x.item.qtd||0),0);

      return `<button onclick="irCategoria('${escapar(cat)}')">
        ${escapar(cat)} <b>${total}</b>
      </button>`;
    }).join('')
    :'<span class="subtitle">As categorias aparecerão aqui quando chegarem novos pedidos.</span>';

  const visiveis=itens.filter(x=>filtro==='all'||x.status===filtro);
  const container=document.getElementById('kitchen-content');

  if(!visiveis.length){
    container.innerHTML=`
      <div class="empty">
        <div class="empty-icon">✓</div>
        <strong>${itens.length?'Nenhum pedido neste filtro':'Aguardando novos pedidos'}</strong>
        <p>${itens.length
          ?'Não há produtos nesta etapa no momento.'
          :'Quando o garçom adicionar produtos às comandas abertas, eles aparecerão aqui automaticamente.'}</p>
      </div>`;
    document.getElementById('last-update').textContent='Painel atualizado';
    return;
  }

  const nomes=categorias.filter(cat=>
    visiveis.some(x=>x.categoria===cat)
  );

  container.innerHTML=nomes.map(nome=>{
    const grupo=visiveis.filter(x=>x.categoria===nome);
    const qtd=grupo.reduce((s,x)=>s+Number(x.item.qtd||0),0);

    return `
      <section class="category" id="cat-${categorias.indexOf(nome)}">
        <div class="category-title">
          <h3>${escapar(nome)}</h3>
          <div class="line"></div>
          <span class="category-count">${qtd} ${qtd===1?'unidade':'unidades'}</span>
        </div>

        <div class="cards">
          ${grupo.map(x=>{
            const status=x.status;
            const c=x.comanda;

            let action='';

            if(status==='waiting'){
              action=`
                <button class="primary"
                  onclick="alterar('${escapar(c.id)}',${x.index},'preparing')">
                  ▶ Iniciar preparo
                </button>`;
            }else if(status==='preparing'){
              action=`
                <button class="success"
                  onclick="alterar('${escapar(c.id)}',${x.index},'ready')">
                  ✓ Marcar como pronto
                </button>`;
            }else if(status==='ready'){
              action=`
                <button class="info"
                  onclick="alterar('${escapar(c.id)}',${x.index},'delivered')">
                  ✓ Entregue ao garçom
                </button>`;
            }else{
              action=`
                <button class="secondary"
                  onclick="alterar('${escapar(c.id)}',${x.index},'waiting')">
                  ↺ Voltar para espera
                </button>`;
            }

            const voltar=status!=='waiting'
              ?`<button class="secondary" onclick="voltarEtapa('${escapar(c.id)}',${x.index},'${status}')">← Etapa anterior</button>`
              :'';

            return `
              <article class="order ${status}">
                <div class="order-head">
                  <div>
                    <div class="location">${escapar(c.tipo)} ${escapar(c.identificacao)}</div>
                    <div class="client">${c.cliente?escapar(c.cliente):'Sem nome informado'}</div>
                  </div>
                  <span class="status ${status}">${nomeStatus(status)}</span>
                </div>

                <div class="product-name">${escapar(x.item.nome)}</div>
                <div class="quantity">Quantidade: <strong>${Number(x.item.qtd)||0}</strong></div>

                <div class="order-footer">
                  <span class="order-number">Comanda de atendimento</span>
                  <span class="order-number">${nomeStatus(status)}</span>
                </div>

                <div class="actions">
                  ${action}
                  ${voltar}
                </div>
              </article>`;
          }).join('')}
        </div>
      </section>`;
  }).join('');

  document.getElementById('last-update').textContent=
    'Atualizado às '+new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
}

function alterar(id,index,status){
  const comandas=lerComandas();
  const c=comandas.find(x=>x.id===id);

  if(!c||c.status!=='open'||!c.itens[index])return;

  c.itens[index].kitchenStatus=status;
  salvarComandas(comandas);

  render();

  avisar({
    waiting:'Pedido voltou para a espera.',
    preparing:'Preparo iniciado!',
    ready:'Pedido pronto! O garçom já pode acompanhar.',
    delivered:'Pedido entregue ao garçom!'
  }[status]||'Status atualizado.');
}

function voltarEtapa(id,index,statusAtual){
  const anterior={
    preparing:'waiting',
    ready:'preparing',
    delivered:'ready'
  }[statusAtual]||'waiting';

  alterar(id,index,anterior);
}

function irCategoria(nome){
  const index=categorias.indexOf(nome);
  const elemento=document.getElementById('cat-'+index);

  if(elemento){
    elemento.scrollIntoView({behavior:'smooth',block:'start'});
  }
}

document.querySelectorAll('[data-filter]').forEach(btn=>{
  btn.addEventListener('click',()=>{
    filtro=btn.dataset.filter;

    document.querySelectorAll('[data-filter]').forEach(b=>{
      b.classList.toggle('active',b===btn);
    });

    render();
  });
});

window.addEventListener('storage',event=>{
  if(event.key===STORAGE_KEY)render();
});

window.addEventListener('focus',render);

render();
setInterval(render,1500);
</script>
</body>
</html>
